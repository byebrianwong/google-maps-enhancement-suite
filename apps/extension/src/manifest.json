{
  "manifest_version": 3,
  "name": "Enhancement Suite for Google Maps",
  "version": "0.0.0",
  "description": "Adds your own ratings to Google Maps. First feature: Park Picker ratings, shown on each place and filled into your list notes as moons.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://www.google.com/maps/*", "http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Enhancement Suite for Google Maps",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "popup.html", "open_in_tab": true },
  "commands": {
    "fill-note": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Fill the note field you are typing in with this place's moons"
    }
  }
}
