# Optional. With this set, travel times come from Google Routes API
# (traffic-aware driving, plus walking and cycling). Enable "Routes API"
# on the key. Without it the app uses the free OSRM demo router for driving
# and a distance-based estimate for walking and biking.
GOOGLE_MAPS_API_KEY=

# Optional. Point at your own OSRM server instead of the public demo.
# OSRM_URL=https://router.project-osrm.org

# Local default is a SQLite file. For a deploy, use a Turso database:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=...
