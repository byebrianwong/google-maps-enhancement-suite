{
  "name": "@repo/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enhancement Suite for Google Maps, the Chrome extension. Shows Park Picker ratings on Google Maps and fills them into the notes on your Google Maps lists.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node build.mjs && node e2e/run.mjs"
  },
  "dependencies": {
    "@repo/core": "*"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
