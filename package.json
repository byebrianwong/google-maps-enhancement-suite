{
  "name": "maps-enhancement-suite",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @repo/web",
    "build": "npm run build -w @repo/web",
    "start": "npm run start -w @repo/web",
    "dev:extension": "npm run dev -w @repo/extension",
    "build:extension": "npm run build -w @repo/extension",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @repo/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "description": "Personal additions to Google Maps: the Park Picker web app and the Enhancement Suite for Google Maps Chrome extension."
}
